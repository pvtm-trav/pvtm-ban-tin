{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bantin.trav.gov.vn/schemas/issue.schema.json",
  "title": "BanTin Publishing Pipeline v2 issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "number", "year", "status", "title", "cover", "sections", "publication"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "number": {"type": "integer", "minimum": 1, "maximum": 99},
    "year": {"type": "integer", "minimum": 2020, "maximum": 2100},
    "release_date": {"type": ["string", "null"], "format": "date"},
    "status": {"enum": ["draft", "review", "published", "archived"]},
    "title": {"type": "string", "minLength": 1},
    "cover": {"type": "object", "additionalProperties": false, "required": ["hero", "headline_articles", "feature_images"], "properties": {"hero": {"type": "string", "pattern": "^/assets/"}, "hero_mode": {"enum": ["offset", "cover"]}, "hero_top_mm": {"type": "number"}, "headline_articles": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{2}$"}}, "feature_images": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^/assets/"}}}},
    "sections": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "articles"], "properties": {"id": {"enum": ["domestic", "foreign", "trade"]}, "title": {"enum": ["TIN TRONG NƯỚC", "TIN NƯỚC NGOÀI", "THÔNG TIN XUẤT NHẬP KHẨU"]}, "articles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{2}$"}}}}},
    "toc_pages": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "publication": {"type": "object", "additionalProperties": false, "required": ["html", "pdf"], "properties": {"html": {"type": "boolean"}, "pdf": {"type": "boolean"}}}
  }
}
